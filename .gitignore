# ==============================================================================
# CheerlyTaskAgent  .gitignore
# ------------------------------------------------------------------------------
# 一句话原则：只提交「能重建项目的源码与配置」，不提交「本机运行产生的东西」。
#
#   ✅ 要提交（本文件不忽略它们）
#     src/                 源码：Python 模块 + web/index.html + projects.seed.json
#     tests/               测试
#     docs/                架构文档
#     README.md            使用说明
#     pyproject.toml       依赖与工具配置
#     uv.lock              依赖锁文件 —— 保证可复现构建，必须提交
#     .gitignore           本文件
#
#   ❌ 不提交（下方规则命中）
#     虚拟环境 / Python 缓存 / 测试缓存 / 运行时状态 / 密钥 / 编辑器与系统文件
#
# ------------------------------------------------------------------------------
# 两个「过滤」不要混淆：
#   1) 本 .gitignore —— 控制 TaskAgent 自身仓库哪些文件进版本控制。
#   2) commitfilter.py —— TaskAgent 向「目标仓库」自动 commit 时，决定
#      codebuddy 改动的哪些文件可以提交（内含 *.lock 等目标仓库规则）。
#      那是给目标仓库兜底用的，与本仓库是否提交 uv.lock 无关：
#      uv.lock 是 TaskAgent 自己的锁文件，应当提交。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1) 虚拟环境与构建产物 —— 不提交（可本地重建）
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.eggs/
*.egg-info/
build/
dist/
out/
target/

# ------------------------------------------------------------------------------
# 2) Python / 测试 / lint 缓存 —— 不提交（自动生成）
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
# pyproject.toml 里配置的 pytest basetemp
.pytest_tmp/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ------------------------------------------------------------------------------
# 3) TaskAgent 运行时状态 —— 绝不提交
#    整个 data/ 都是本机的任务数据 / 报告 / 隔离 worktree / 本地配置：
#      tasks/       工作项 JSON（含执行记录）
#      reports/     生成的 Markdown 报告
#      worktrees/   apply 时的 git worktree 副本
#      projects.json        用户手动维护的项目→本地路径映射（含本机绝对路径）
#      commit-ignore.txt    用户自定义的提交过滤规则
#    重建时由代码按 src/taskagent/projects.seed.json 自动初始化，无需入库。
# ------------------------------------------------------------------------------
data/

# ------------------------------------------------------------------------------
# 4) 密钥与本地环境变量 —— 绝不提交
# ------------------------------------------------------------------------------
.env
.env.*
# 若以后加入示例配置，允许提交
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json

# ------------------------------------------------------------------------------
# 5) 日志 / 临时文件 / 编辑器 / 操作系统 —— 不提交
# ------------------------------------------------------------------------------
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.cache/

# ------------------------------------------------------------------------------
# 6) WorkBuddy 本地工作区数据 —— 不提交（会话记忆等本地状态）
#    说明：这里仅「本地忽略」，不会删除该目录。
# ------------------------------------------------------------------------------
.workbuddy/

# ------------------------------------------------------------------------------
# 7) 前端工程（web/）—— 依赖与构建产物不入仓
#    `src/taskagent/web/` 是 Vite 的输出目录，由 `uv run taskagent web-build` 生成；
#    首次运行服务前需要构建一次（未构建时后端会返回引导页）。
# ------------------------------------------------------------------------------
.pnpm-store/
web/node_modules/
web/.tsbuild/
web/dist/
web/*.tsbuildinfo
*.tsbuildinfo
src/taskagent/web/
